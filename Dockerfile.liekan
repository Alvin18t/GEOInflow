FROM node:22.23.3-alpine AS dependencies
WORKDIR /app
RUN http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY" no_proxy="$NO_PROXY" apk add --no-cache libc6-compat && npm install -g pnpm@12.3.4
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/mcp/package.json ./packages/mcp/
COPY packages/mcp/bin ./packages/mcp/bin/
RUN --mount=type=cache,id=liekan-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store --network-concurrency=8 --fetch-timeout=300000
FROM dependencies AS builder
COPY . .
COPY docker/proxy.ts ./src/proxy.ts
ENV DATABASE_URL=postgresql://user:pass@localhost:5432/dummy
ENV NEXT_TELEMETRY_DISABLED=1
ARG SKIP_BUILD_GEO=1
ENV SKIP_BUILD_GEO=$SKIP_BUILD_GEO
RUN --mount=type=cache,id=liekan-prisma-engines,target=/root/.cache/prisma \
    RAYON_NUM_THREADS=2 NODE_OPTIONS=--max-old-space-size=2048 pnpm build:docker
RUN pnpm licenses list --json > /tmp/liekan-licenses.json && node scripts/liekan-license-inventory.mjs /tmp/liekan-licenses.json

FROM node:22.23.3-alpine AS runner
WORKDIR /app
RUN http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY" no_proxy="$NO_PROXY" apk add --no-cache libc6-compat && addgroup -S -g 1001 nodejs && adduser -S -u 1001 -G nodejs nextjs
ARG LIEKAN_REVISION=development
ARG LIEKAN_VERSION=0.2.3
ARG LIEKAN_UPSTREAM=ec0ff50388c264ed8ce46f00967e92f7e71476ae
ARG LIEKAN_UI=139d21c5ccde96c433fa1da3db6fa4cdd71f5e7660a9c6297d79861c19b38385
ARG LIEKAN_FEATURE_UI=e0d8650251be7eb48baef8aec902c3cd6952c162ee6a5f81add5eb9ea89d6835
ARG LIEKAN_MIGRATION=5
LABEL org.opencontainers.image.title="Liekan 猎看统计" \
      org.opencontainers.image.version=$LIEKAN_VERSION \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision=$LIEKAN_REVISION \
      io.liekan.upstream.revision=$LIEKAN_UPSTREAM \
      io.liekan.ui.sha256=$LIEKAN_UI \
      io.liekan.feature-ui.sha256=$LIEKAN_FEATURE_UI \
      io.liekan.migration=$LIEKAN_MIGRATION
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
# Preserve the frozen dependency graph for both Next and the migration CLI.
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/packages ./packages
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/geo ./geo
COPY --from=builder /app/package.json /app/prisma.config.ts ./
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/db/liekan ./db/liekan
COPY --from=builder /app/config/liekan ./config/liekan
COPY --from=builder /app/generated ./generated
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/src/lib/two-factor/crypto.ts ./checks/two-factor.ts
COPY --from=builder /app/LICENSE /app/THIRD_PARTY_NOTICES.md ./
USER nextjs
EXPOSE 3000
CMD ["sh","scripts/liekan-start.sh"]
