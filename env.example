POSTGRES_USER=liekan
POSTGRES_DB=liekan
POSTGRES_PASSWORD=replace-with-a-random-secret
DATABASE_URL=postgresql://liekan:replace-with-a-random-secret@127.0.0.1:15435/liekan
APP_SECRET=replace-with-a-random-secret
TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-random-secret
DISABLE_TELEMETRY=1
NEXT_TELEMETRY_DISABLED=1
DEFAULT_LOCALE=zh-CN
API_KEY_ENABLED=1

# Automatic logs: serve the application and receiver through the same HTTPS origin.
LIEKAN_PUBLIC_URL=
LIEKAN_LOG_CREDENTIALS_KEY=
LIEKAN_LOG_PREVIOUS_KEYS=
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Build-time Ed25519 key file, kept outside the repository and container image.
LIEKAN_AGENT_SIGNING_KEY_FILE=
